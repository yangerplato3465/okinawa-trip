rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each trip is one document at /trips/{tripId}.
    // The long random tripId in the share link acts as the password:
    // you can open or edit a trip only if you know its exact ID.
    match /trips/{tripId} {
      allow get: if tripId.size() >= 20;
      allow create, update: if tripId.size() >= 20
        && request.resource.data.title is string
        && request.resource.data.days is list;
      // Nobody can list all trips (that would reveal every link) or delete one.
      allow list, delete: if false;
    }
  }
}
