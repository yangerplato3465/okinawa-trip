rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each trip is one document at /trips/{tripId}.
    // The trip list is public: anyone who opens the site can see and edit every trip.
    match /trips/{tripId} {
      allow get, list: if true;
      allow create, update: if tripId.size() >= 20
        && request.resource.data.title is string
        && request.resource.data.days is list;
      // Nobody can delete a whole trip from the database.
      allow delete: if false;
    }
  }
}
